WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ line_comment | block_comment }
line_comment = _{ "//" ~ (!NEWLINE ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

query = { SOI ~ query_preamble? ~ query_body ~ semicolon? ~ EOI }
query_preamble = _{ cypher_prefix ~ execution_mode? | execution_mode ~ cypher_prefix? }
execution_mode = { KW_EXPLAIN | KW_PROFILE }
cypher_prefix = { KW_CYPHER ~ (cypher_version ~ query_option* | query_option+) }
cypher_version = @{ ASCII_DIGIT+ }
query_option = { symbolic_name ~ "=" ~ option_value }
option_value = { symbolic_name | string_literal | float_literal | integer_literal }
semicolon = _{ ";" }

query_body = { conditional_query | composed_query }
conditional_query = { when_branch ~ when_branch* ~ else_branch? }
when_branch = { KW_WHEN ~ expression ~ KW_THEN ~ conditional_branch_query }
else_branch = { KW_ELSE ~ conditional_branch_query }
conditional_branch_query = _{ braced_query | composed_query }
braced_query = { "{" ~ query_body ~ "}" }
composed_query = {
      single_query ~ (query_connector ~ composed_operand)*
    | braced_query ~ query_connector ~ composed_operand ~ (query_connector ~ composed_operand)*
}
composed_operand = _{ single_query | braced_query }
query_connector = { union_connector | KW_NEXT }
union_connector = { KW_UNION ~ (KW_ALL | KW_DISTINCT)? }
single_query = { clause+ }

clause = _{
      graph_type_clause
    | create_index_clause
    | drop_index_clause
    | create_constraint_clause
    | drop_constraint_clause
    | show_clause
    | optional_match_clause
    | match_clause
    | filter_clause
    | return_clause
    | with_clause
    | let_clause
    | unwind_clause
    | for_clause
    | finish_clause
    | insert_clause
    | create_clause
    | merge_clause
    | set_clause
    | remove_clause
    | detach_delete_clause
    | nodetach_delete_clause
    | delete_clause
    | foreach_clause
    | call_clause
    | load_csv_clause
}

optional_match_clause = { KW_OPTIONAL ~ KW_MATCH ~ match_mode? ~ pattern ~ search_subclause* ~ where_subclause? }
match_clause = { KW_MATCH ~ match_mode? ~ pattern ~ search_subclause* ~ where_subclause? }
match_mode = { KW_DIFFERENT ~ KW_RELATIONSHIPS | KW_REPEATABLE ~ KW_ELEMENTS }
where_subclause = { KW_WHERE ~ expression }
filter_clause = { KW_FILTER ~ expression }

search_subclause = {
    KW_SEARCH ~ variable ~ KW_IN ~ "(" ~ KW_VECTOR ~ KW_INDEX ~ index_name ~ KW_FOR ~ expression
    ~ search_where? ~ KW_LIMIT ~ expression ~ ")" ~ search_score?
}
search_where = { KW_WHERE ~ expression }
search_score = { KW_SCORE ~ KW_AS ~ projection_alias }

return_clause = { KW_RETURN ~ projection_body }
with_clause = { KW_WITH ~ projection_body ~ where_subclause? }
projection_body = { projection_quantifier? ~ projection_items ~ group_by? ~ order_by? ~ skip_clause? ~ limit_clause? }
projection_quantifier = { KW_DISTINCT | KW_ALL ~ !("(" ~ predicate_variable ~ KW_IN) }
projection_items = { projection_item ~ ("," ~ projection_item)* }
projection_item = { star_projection | expression ~ projection_alias_clause? }
star_projection = { "*" }
projection_alias_clause = { KW_AS ~ projection_alias }
projection_alias = { symbolic_name }
group_by = { KW_GROUP ~ KW_BY ~ (group_by_all | group_by_empty | expression_list) }
group_by_all = { KW_ALL }
group_by_empty = { "(" ~ ")" }
order_by = { KW_ORDER ~ KW_BY ~ order_item ~ ("," ~ order_item)* }
order_item = { expression ~ order_direction? }
order_direction = { KW_ASC | KW_ASCENDING | KW_DESC | KW_DESCENDING }
skip_clause = { (KW_SKIP | KW_OFFSET) ~ expression }
limit_clause = { KW_LIMIT ~ expression }

let_clause = { KW_LET ~ let_binding ~ ("," ~ let_binding)* }
let_binding = { let_variable ~ "=" ~ expression }
let_variable = { symbolic_name }
unwind_clause = { KW_UNWIND ~ expression ~ KW_AS ~ unwind_variable }
unwind_variable = { symbolic_name }
for_clause = { KW_FOR ~ for_variable ~ KW_IN ~ expression }
for_variable = { symbolic_name }
finish_clause = { KW_FINISH }

create_clause = { KW_CREATE ~ pattern }
insert_clause = { KW_INSERT ~ pattern }
merge_clause = { KW_MERGE ~ pattern_part ~ merge_action* }
merge_action = { KW_ON ~ (KW_CREATE | KW_MATCH) ~ set_clause }
set_clause = { KW_SET ~ set_item ~ ("," ~ set_item)* }
set_item = { assignable_property ~ set_operator ~ expression | variable ~ set_operator ~ expression | variable ~ label_update }
set_operator = { "+=" | "=" }
assignable_property = { (variable | parenthesized_expression) ~ (property_lookup+ | dynamic_property_lookup) }
label_update = { (":" ~ (label_name | dynamic_name))+ }
remove_clause = { KW_REMOVE ~ remove_item ~ ("," ~ remove_item)* }
remove_item = { property_expression | variable ~ label_update }
detach_delete_clause = { KW_DETACH ~ KW_DELETE ~ expression_list }
nodetach_delete_clause = { KW_NODETACH ~ KW_DELETE ~ expression_list }
delete_clause = { KW_DELETE ~ expression_list }
foreach_clause = { KW_FOREACH ~ "(" ~ foreach_variable ~ KW_IN ~ expression ~ "|" ~ update_clause+ ~ ")" }
foreach_variable = { symbolic_name }
update_clause = _{ create_clause | insert_clause | merge_clause | set_clause | remove_clause | detach_delete_clause | nodetach_delete_clause | delete_clause | foreach_clause }

call_clause = { KW_CALL ~ (subquery_call | procedure_call) }
subquery_call = { subquery_scope? ~ "{" ~ query_body ~ "}" ~ transaction_subclause? }
subquery_scope = { "(" ~ (subquery_scope_all | subquery_import ~ ("," ~ subquery_import)*)? ~ ")" }
subquery_scope_all = { "*" }
subquery_import = { symbolic_name }
transaction_subclause = {
    KW_IN ~ transaction_concurrent? ~ KW_TRANSACTIONS ~ transaction_batch? ~ transaction_disjoint? ~ transaction_tail*
}
transaction_concurrent = { (expression ~ KW_CONCURRENT) | KW_CONCURRENT }
transaction_batch = { KW_OF ~ expression ~ (KW_ROW | KW_ROWS) }
transaction_disjoint = {
    KW_DISJOINT ~ KW_BY ~ (transaction_disjoint_none | transaction_disjoint_auto | transaction_disjoint_explicit)
}
transaction_disjoint_none = { KW_NONE }
transaction_disjoint_auto = { KW_AUTO }
transaction_disjoint_explicit = { "(" ~ expression_list ~ ")" }
transaction_tail = _{ transaction_error | transaction_status }
transaction_error = {
    KW_ON ~ KW_ERROR ~ (transaction_error_continue | transaction_error_break | transaction_error_fail | transaction_error_retry)
}
transaction_error_continue = { KW_CONTINUE }
transaction_error_break = { KW_BREAK }
transaction_error_fail = { KW_FAIL }
transaction_error_retry = {
    KW_RETRY ~ transaction_retry_duration? ~ transaction_retry_fallback?
}
transaction_retry_fallback = { KW_THEN ~ (KW_CONTINUE | KW_BREAK | KW_FAIL) }
transaction_retry_duration = { KW_FOR? ~ expression ~ (KW_SEC | KW_SECOND | KW_SECONDS) }
transaction_status = { KW_REPORT ~ KW_STATUS ~ KW_AS ~ transaction_status_binding }
transaction_status_binding = { symbolic_name }
procedure_call = { procedure_name ~ procedure_args? ~ yield_clause? }
procedure_name = { qualified_name }
procedure_args = { "(" ~ expression_list? ~ ")" }
yield_clause = { KW_YIELD ~ (yield_all | yield_item ~ ("," ~ yield_item)*) ~ where_subclause? }
yield_all = { "*" }
yield_item = { yield_name ~ projection_alias_clause? }
yield_name = { symbolic_name }

load_csv_clause = {
    KW_LOAD ~ KW_CSV ~ load_csv_headers? ~ KW_FROM ~ expression ~ KW_AS ~ load_csv_binding
    ~ load_csv_field_terminator?
}
load_csv_headers = { KW_WITH ~ KW_HEADERS }
load_csv_field_terminator = { KW_FIELDTERMINATOR ~ string_literal }
load_csv_binding = { symbolic_name }

pattern = { pattern_part ~ ("," ~ pattern_part)* }
pattern_part = { path_assignment? ~ path_selector? ~ path_mode? ~ pattern_element }
path_assignment = { pattern_variable ~ "=" }
path_mode = { (KW_WALK | KW_TRAIL | KW_ACYCLIC) ~ path_or_paths? }
pattern_element = { path_segment+ }
path_segment = _{ grouped_pattern | simple_path_pattern }
simple_path_pattern = { node_pattern ~ relationship_chain* }
grouped_pattern = { "(" ~ path_assignment? ~ pattern_element ~ where_subclause? ~ ")" ~ quantifier }
relationship_chain = { relationship_pattern ~ quantifier? ~ node_pattern }
node_pattern = { "(" ~ pattern_variable? ~ label_expression? ~ map_literal? ~ inline_where? ~ ")" }
pattern_variable = { symbolic_name }
inline_where = { KW_WHERE ~ expression }

relationship_pattern = { left_arrow? ~ "-" ~ relationship_detail? ~ "-" ~ right_arrow? }
left_arrow = { "<" }
right_arrow = { ">" }
relationship_detail = {
    "[" ~ relationship_variable? ~ relationship_type_expression? ~ variable_length? ~ map_literal? ~ inline_where? ~ "]"
}
relationship_variable = { symbolic_name }
relationship_type_expression = { ":" ~ relationship_type_disjunction ~ (":" ~ relationship_type_disjunction)* }
relationship_type_disjunction = { relationship_type_conjunction ~ ("|" ~ ":"? ~ relationship_type_conjunction)* }
relationship_type_conjunction = { relationship_type_negation ~ ("&" ~ relationship_type_negation)* }
relationship_type_negation = { name_negation_operator* ~ relationship_type_atom }
relationship_type_atom = {
    relationship_type_name | dynamic_name | name_wildcard | "(" ~ relationship_type_disjunction ~ ")"
}
relationship_type_name = { symbolic_name | dynamic_name }
variable_length = { "*" ~ range_literal? }
range_literal = { integer_literal? ~ ".." ~ integer_literal? | integer_literal }

label_expression = { ":" ~ label_disjunction ~ (":" ~ label_disjunction)* | KW_IS ~ label_disjunction }
label_disjunction = { label_conjunction ~ ("|" ~ label_conjunction)* }
label_conjunction = { label_negation ~ ("&" ~ label_negation)* }
label_negation = { name_negation_operator* ~ label_atom }
label_atom = { label_name | dynamic_name | name_wildcard | "(" ~ label_disjunction ~ ")" }
label_name = { symbolic_name }
dynamic_name = { "$" ~ "(" ~ expression ~ ")" }
name_wildcard = { "%" }
name_negation_operator = { "!" }

quantifier = { "*" | "+" | "{" ~ (quantifier_range | quantifier_fixed) ~ "}" }
quantifier_fixed = { quantifier_lower_bound }
quantifier_range = { quantifier_lower_bound ~ "," ~ quantifier_upper_bound? | "," ~ quantifier_upper_bound }
quantifier_lower_bound = @{ ASCII_DIGIT+ }
quantifier_upper_bound = @{ ASCII_DIGIT+ }
path_selector = _{
      path_selector_all_shortest
    | path_selector_any_shortest
    | path_selector_shortest_groups
    | path_selector_shortest_paths
    | path_selector_all
    | path_selector_any
}
path_selector_all_shortest = { KW_ALL ~ KW_SHORTEST ~ path_or_paths? }
path_selector_any_shortest = { KW_ANY ~ KW_SHORTEST ~ path_or_paths? }
path_selector_shortest_groups = {
    KW_SHORTEST ~ path_count? ~ path_or_paths? ~ (KW_GROUP | KW_GROUPS)
}
path_selector_shortest_paths = { KW_SHORTEST ~ path_count ~ path_or_paths? }
path_selector_all = { KW_ALL ~ path_or_paths? }
path_selector_any = { KW_ANY ~ path_count? ~ path_or_paths? }
path_count = @{ ASCII_DIGIT+ | parameter }
path_or_paths = _{ KW_PATH | KW_PATHS }

expression_fragment = { SOI ~ expression ~ EOI }
expression_list = { expression ~ ("," ~ expression)* }
expression = { or_expression }
or_expression = { xor_expression ~ (OR_OP ~ xor_expression)* }
xor_expression = { and_expression ~ (XOR_OP ~ and_expression)* }
and_expression = { not_expression ~ (AND_OP ~ not_expression)* }
not_expression = { NOT_OP* ~ comparison_expression }
comparison_expression = { additive_expression ~ comparison_suffix* }
comparison_suffix = {
      comparison_operator ~ additive_expression
    | KW_IN ~ additive_expression
    | KW_STARTS ~ KW_WITH ~ additive_expression
    | KW_ENDS ~ KW_WITH ~ additive_expression
    | KW_CONTAINS ~ additive_expression
    | KW_IS ~ KW_NOT? ~ KW_NULL
    | KW_IS ~ KW_NOT? ~ normalization_form? ~ KW_NORMALIZED
    | KW_IS ~ KW_NOT? ~ (KW_TYPED ~ type_expression | "::" ~ type_expression)
    | label_is_predicate
}
label_is_predicate = {
    KW_IS ~ (KW_LABELED ~ label_disjunction | KW_NOT ~ KW_LABELED? ~ label_disjunction)
}
comparison_operator = { "=" | "<>" | "!=" | "<=" | ">=" | "<" | ">" | "=~" }
additive_expression = { multiplicative_expression ~ (additive_operator ~ multiplicative_expression)* }
additive_operator = { "+" | "-" | "||" }
multiplicative_expression = { power_expression ~ (multiplicative_operator ~ power_expression)* }
multiplicative_operator = { "*" | "/" | "%" }
power_expression = { unary_expression ~ ("^" ~ unary_expression)* }
unary_expression = { unary_operator* ~ postfix_expression }
unary_operator = { "+" | "-" }
postfix_expression = { primary_expression ~ postfix_operator* }
postfix_operator = { property_lookup | subscript | label_predicate | type_predicate_shorthand }
label_predicate = { ":" ~ label_disjunction }
property_lookup = { "." ~ property_key }
property_expression = { variable ~ (property_lookup+ | dynamic_property_lookup) }
property_key = { symbolic_name }
subscript = { "[" ~ (slice | expression)? ~ "]" }
dynamic_property_lookup = { "[" ~ expression ~ "]" }
slice = { expression? ~ ".." ~ expression? }
type_predicate_shorthand = { "::" ~ type_expression }

primary_expression = {
      case_expression
    | exists_subquery_expression
    | count_subquery_expression
    | collect_subquery_expression
    | list_comprehension
    | pattern_comprehension
    | map_projection
    | property_exists_function
    | trim_function_call
    | normalize_function_call
    | vector_distance_function_call
    | vector_norm_function_call
    | vector_function_call
    | list_predicate_function
    | all_reduce_function
    | reduce_function
    | function_call
    | pattern_expression
    | interpolated_string
    | parameter
    | null_literal
    | boolean_literal
    | float_literal
    | integer_literal
    | string_literal
    | list_literal
    | map_literal
    | parenthesized_expression
    | variable
}
parenthesized_expression = { "(" ~ expression ~ ")" }
property_exists_function = { property_exists_name ~ "(" ~ expression ~ "," ~ property_key ~ ")" }
property_exists_name = { KW_PROPERTY_EXISTS }
trim_function_call = { trim_function_name ~ "(" ~ (trim_from_arguments | expression) ~ ")" }
trim_function_name = @{ ^"trim" ~ !ident_continue }
trim_from_arguments = {
      trim_specification ~ expression? ~ trim_from_keyword ~ expression
    | expression ~ trim_from_keyword ~ expression
    | trim_from_keyword ~ expression
}
trim_specification = @{ (^"LEADING" | ^"TRAILING" | ^"BOTH") ~ !ident_continue }
trim_from_keyword = _{ ^"FROM" ~ !ident_continue }
normalize_function_call = { normalize_function_name ~ "(" ~ expression ~ ("," ~ normalization_form)? ~ ")" }
normalize_function_name = @{ ^"normalize" ~ !ident_continue }
normalization_form = @{ (^"NFC" | ^"NFD" | ^"NFKC" | ^"NFKD") ~ !ident_continue }
vector_distance_function_call = { vector_distance_function_name ~ "(" ~ expression ~ "," ~ expression ~ "," ~ vector_distance_metric ~ ")" }
vector_norm_function_call = { vector_norm_function_name ~ "(" ~ expression ~ "," ~ vector_distance_metric ~ ")" }
vector_distance_function_name = @{ ^"vector_distance" ~ !ident_continue }
vector_norm_function_name = @{ ^"vector_norm" ~ !ident_continue }
vector_distance_metric = @{ (^"EUCLIDEAN_SQUARED" | ^"EUCLIDEAN" | ^"MANHATTAN" | ^"COSINE" | ^"DOT" | ^"HAMMING") ~ !ident_continue }
vector_function_call = { KW_VECTOR ~ "(" ~ expression ~ "," ~ expression ~ ("," ~ vector_coordinate_literal ~ (KW_NOT ~ KW_NULL)?)? ~ ")" }
vector_coordinate_literal = _{ vector_signed_integer | vector_coordinate_name }
vector_signed_integer = { KW_SIGNED ~ KW_INTEGER_TYPE }
vector_coordinate_name = { KW_INTEGER_TYPE | KW_FLOAT_TYPE | symbolic_name }
list_predicate_function = { (KW_ALL | KW_ANY | KW_NONE | KW_SINGLE) ~ "(" ~ predicate_variable ~ KW_IN ~ expression ~ (KW_WHERE ~ expression)? ~ ")" }
predicate_variable = { symbolic_name }
reduce_function = {
    KW_REDUCE ~ "(" ~ reduction_accumulator ~ "=" ~ expression ~ ","
    ~ reduction_variable ~ KW_IN ~ expression ~ "|" ~ expression ~ ")"
}
all_reduce_function = {
    KW_ALLREDUCE ~ "(" ~ reduction_accumulator ~ "=" ~ expression ~ ","
    ~ reduction_variable ~ KW_IN ~ expression ~ "|" ~ expression ~ "," ~ expression ~ ")"
}
reduction_accumulator = { symbolic_name }
reduction_variable = { symbolic_name }
function_call = { function_name ~ "(" ~ function_quantifier? ~ function_arguments? ~ ")" }
function_quantifier = { KW_DISTINCT }
function_arguments = { "*" | expression_list }
pattern_expression = { node_pattern ~ relationship_chain+ }
function_name = { qualified_name }
qualified_name = { symbolic_name ~ ("." ~ symbolic_name)* }
variable = { symbolic_name }
parameter = @{ "$" ~ parameter_name }
parameter_name = { (XID_CONTINUE | "_")+ }

list_literal = { "[" ~ expression_list? ~ "]" }
list_comprehension = {
    "[" ~ comprehension_variable ~ KW_IN ~ expression ~ (KW_WHERE ~ expression)? ~ ("|" ~ expression)? ~ "]"
}
comprehension_variable = { symbolic_name }
pattern_comprehension = { "[" ~ path_assignment? ~ pattern_element ~ (KW_WHERE ~ expression)? ~ "|" ~ expression ~ "]" }
map_literal = { "{" ~ map_entry_list? ~ "}" }
map_entry_list = { map_entry ~ ("," ~ map_entry)* }
map_entry = { map_key ~ ":" ~ expression }
map_key = { symbolic_name | string_literal }
map_projection = { variable ~ "{" ~ map_projection_item ~ ("," ~ map_projection_item)* ~ "}" }
map_projection_item = { ".*" | "." ~ property_key | map_key ~ ":" ~ expression | variable }

case_expression = { searched_case | simple_case }
searched_case = { KW_CASE ~ when_expression+ ~ (KW_ELSE ~ expression)? ~ KW_END }
simple_case = { KW_CASE ~ expression ~ when_expression+ ~ (KW_ELSE ~ expression)? ~ KW_END }
when_expression = { KW_WHEN ~ expression ~ KW_THEN ~ expression }
exists_subquery_expression = { KW_EXISTS ~ "{" ~ (query_body | pattern ~ where_subclause?) ~ "}" }
count_subquery_expression = { KW_COUNT ~ "{" ~ query_body ~ "}" }
collect_subquery_expression = { KW_COLLECT ~ "{" ~ query_body ~ "}" }

null_literal = { KW_NULL }
boolean_literal = { KW_TRUE | KW_FALSE }
integer_literal = @{ sign? ~ (hex_integer | octal_integer | decimal_integer) }
hex_integer = { "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ }
octal_integer = { "0" ~ ("o" | "O") ~ ASCII_OCT_DIGIT+ }
decimal_integer = { ASCII_DIGIT+ }
float_literal = @{ sign? ~ ((ASCII_DIGIT+ ~ "." ~ !"." ~ ASCII_DIGIT* | "." ~ ASCII_DIGIT+) ~ exponent? | ASCII_DIGIT+ ~ exponent) }
exponent = { ("e" | "E") ~ sign? ~ ASCII_DIGIT+ }
sign = { "+" | "-" }
string_literal = @{ single_quoted_string | double_quoted_string }
single_quoted_string = { "'" ~ ("\\" ~ ANY | "''" | !"'" ~ ANY)* ~ "'" }
double_quoted_string = { "\"" ~ ("\\" ~ ANY | "\"\"" | !"\"" ~ ANY)* ~ "\"" }
interpolated_string = @{ ("s" | "S") ~ "\"" ~ ("\\" ~ ANY | !"\"" ~ ANY)* ~ "\"" }

// Schema / index / current-graph commands
create_index_clause = {
    KW_CREATE ~ index_kind? ~ KW_INDEX ~ index_name? ~ if_not_exists? ~ KW_FOR ~ index_pattern ~ KW_ON ~ index_target ~ index_additional_properties? ~ options_clause?
}
index_kind = { KW_LOOKUP | KW_RANGE | KW_TEXT | KW_POINT | KW_FULLTEXT | KW_VECTOR }
index_name = { symbolic_name }
if_not_exists = { KW_IF ~ KW_NOT ~ KW_EXISTS }
index_pattern = { node_pattern ~ relationship_pattern ~ node_pattern | node_pattern }
index_target = { index_target_each? ~ ("[" ~ expression_list ~ "]" | "(" ~ expression_list ~ ")" | expression) }
index_target_each = { KW_EACH }
index_additional_properties = { KW_WITH ~ "[" ~ property_expression ~ ("," ~ property_expression)* ~ "]" }
if_exists = { KW_IF ~ KW_EXISTS }
drop_index_clause = { KW_DROP ~ KW_INDEX ~ index_name ~ if_exists? }

create_constraint_clause = {
    KW_CREATE ~ KW_CONSTRAINT ~ constraint_name? ~ if_not_exists? ~ KW_FOR ~ index_pattern ~ KW_REQUIRE ~ constraint_requirement ~ options_clause?
}
constraint_name = { symbolic_name }
constraint_requirement = { property_type_constraint | constraint_property_or_tuple ~ KW_IS ~ constraint_kind }
property_type_constraint = { constraint_property_or_tuple ~ (KW_IS? ~ "::" | KW_IS ~ KW_TYPED) ~ type_expression }
constraint_property_or_tuple = { property_expression | "(" ~ property_expression ~ ("," ~ property_expression)* ~ ")" }
expression_or_tuple = { expression | "(" ~ expression_list ~ ")" }
constraint_kind = { (KW_NODE | KW_REL | KW_RELATIONSHIP)? ~ (KW_KEY | KW_UNIQUE) | KW_NOT ~ KW_NULL }
drop_constraint_clause = { KW_DROP ~ KW_CONSTRAINT ~ constraint_name ~ if_exists? }
options_clause = { KW_OPTIONS ~ map_literal }

show_clause = {
    KW_SHOW ~ show_target ~ show_as_graph? ~ show_yield? ~ where_subclause? ~ return_clause?
}
show_as_graph = { KW_AS ~ KW_GRAPH }
show_target = {
      KW_CURRENT ~ KW_GRAPH ~ KW_TYPE
    | (KW_ALL | index_kind)? ~ (KW_INDEX | KW_INDEXES)
    | show_constraint_filter? ~ (KW_CONSTRAINT | KW_CONSTRAINTS)
    | (KW_FUNCTION | KW_FUNCTIONS)
    | (KW_PROCEDURE | KW_PROCEDURES)
}
show_constraint_filter = {
      KW_ALL
    | KW_NODE ~ KW_PROPERTY? ~ (KW_UNIQUE | KW_UNIQUENESS)
    | (KW_REL | KW_RELATIONSHIP) ~ KW_PROPERTY? ~ (KW_UNIQUE | KW_UNIQUENESS)
    | KW_PROPERTY? ~ (KW_UNIQUE | KW_UNIQUENESS)
    | KW_NODE ~ KW_PROPERTY ~ (KW_EXIST | KW_EXISTENCE)
    | (KW_REL | KW_RELATIONSHIP) ~ KW_PROPERTY ~ (KW_EXIST | KW_EXISTENCE)
    | KW_PROPERTY ~ (KW_EXIST | KW_EXISTENCE)
    | KW_NODE ~ (KW_EXIST | KW_EXISTENCE)
    | (KW_REL | KW_RELATIONSHIP) ~ (KW_EXIST | KW_EXISTENCE)
    | (KW_EXIST | KW_EXISTENCE)
    | KW_NODE ~ KW_PROPERTY ~ KW_TYPE
    | (KW_REL | KW_RELATIONSHIP) ~ KW_PROPERTY ~ KW_TYPE
    | KW_PROPERTY ~ KW_TYPE
    | KW_NODE ~ KW_KEY
    | (KW_REL | KW_RELATIONSHIP) ~ KW_KEY
    | KW_KEY
}
show_yield = { KW_YIELD ~ (yield_all | projection_items) ~ order_by? ~ skip_clause? ~ limit_clause? }

graph_type_clause = { KW_ALTER ~ KW_CURRENT ~ KW_GRAPH ~ KW_TYPE ~ graph_type_operation ~ graph_type_spec }
graph_type_operation = { KW_SET | KW_ADD | KW_ALTER | KW_DROP }
graph_type_spec = { "{" ~ graph_type_entries? ~ "}" }
graph_type_entries = { graph_type_entry ~ ("," ~ graph_type_entry)* }
graph_type_entry = { graph_relationship_type | graph_node_type | graph_constraint }
graph_node_type = {
    "(" ~ graph_alias? ~ graph_label_marker ~ graph_label ~ graph_implies ~ graph_implied_labels? ~ graph_property_map? ~ ")" ~ graph_require*
}
graph_relationship_type = {
    graph_endpoint ~ "-" ~ "[" ~ graph_alias? ~ graph_label_marker ~ graph_relationship_name ~ graph_implies ~ graph_property_map? ~ "]" ~ "->" ~ graph_endpoint ~ graph_require*
}
graph_endpoint = { "(" ~ (graph_alias? ~ graph_label_marker ~ graph_label ~ graph_implies?)? ~ ")" }
graph_alias = { symbolic_name }
graph_label_marker = { ":" | KW_IS }
graph_label = { symbolic_name }
graph_relationship_name = { symbolic_name }
graph_implies = { "=>" | KW_IMPLIES }
graph_implied_labels = { graph_label_marker ~ graph_label ~ ("&" ~ graph_label)* }
graph_property_map = { "{" ~ graph_property_list? ~ "}" }
graph_property_list = { graph_property ~ ("," ~ graph_property)* }
graph_property = { property_key ~ graph_property_type ~ graph_property_constraint? }
graph_property_type = { (KW_IS? ~ "::" | KW_IS ~ KW_TYPED) ~ type_expression }
graph_property_constraint = { KW_IS ~ (KW_NODE | KW_REL | KW_RELATIONSHIP)? ~ (KW_KEY | KW_UNIQUE) }
graph_require = { KW_REQUIRE ~ expression_or_tuple ~ KW_IS ~ (KW_NODE | KW_REL | KW_RELATIONSHIP)? ~ (KW_KEY | KW_UNIQUE) }
graph_constraint = { KW_CONSTRAINT ~ (constraint_name ~ graph_constraint_definition? | graph_constraint_definition) }
graph_constraint_definition = _{ KW_FOR ~ graph_constraint_pattern ~ KW_REQUIRE ~ constraint_requirement }
graph_constraint_pattern = _{ graph_constraint_relationship_pattern | graph_constraint_node_pattern }
graph_constraint_node_pattern = {
    "(" ~ graph_alias? ~ graph_label_marker ~ graph_label ~ graph_implies? ~ ")"
}
graph_constraint_relationship_pattern = {
    "(" ~ ")" ~ "-" ~ "[" ~ graph_alias? ~ graph_label_marker ~ graph_relationship_name ~ graph_implies? ~ "]" ~ "-" ~ right_arrow? ~ "(" ~ ")"
}

type_expression = { type_term ~ ("|" ~ type_term)* }
type_term = { type_primary ~ nullability? ~ (type_suffix ~ nullability?)* }
type_primary = _{ vector_type | type_name ~ type_parameters? }
type_name = _{
      type_any_property_value
    | type_property_value
    | type_any_relationship
    | type_any_edge
    | type_any_vertex
    | type_any_node
    | type_signed_integer
    | type_timestamp_without_time_zone
    | type_timestamp_with_time_zone
    | type_time_without_time_zone
    | type_time_with_time_zone
    | type_local_datetime
    | type_zoned_datetime
    | type_local_time
    | type_zoned_time
    | type_any_value
    | type_simple_name
}
type_any_property_value = { KW_ANY ~ KW_PROPERTY ~ KW_VALUE }
type_property_value = { KW_PROPERTY ~ KW_VALUE }
type_any_relationship = { KW_ANY ~ KW_RELATIONSHIP }
type_any_edge = { KW_ANY ~ KW_EDGE }
type_any_vertex = { KW_ANY ~ KW_VERTEX }
type_any_node = { KW_ANY ~ KW_NODE }
type_signed_integer = { KW_SIGNED ~ KW_INTEGER_TYPE }
type_timestamp_without_time_zone = { KW_TIMESTAMP ~ KW_WITHOUT ~ time_zone_designator }
type_timestamp_with_time_zone = { KW_TIMESTAMP ~ KW_WITH ~ time_zone_designator }
type_time_without_time_zone = { KW_TIME ~ KW_WITHOUT ~ time_zone_designator }
type_time_with_time_zone = { KW_TIME ~ KW_WITH ~ time_zone_designator }
time_zone_designator = _{ KW_TIME ~ KW_ZONE | KW_TIMEZONE }
type_local_datetime = { KW_LOCAL ~ KW_DATETIME }
type_zoned_datetime = { KW_ZONED ~ KW_DATETIME }
type_local_time = { KW_LOCAL ~ KW_TIME }
type_zoned_time = { KW_ZONED ~ KW_TIME }
type_any_value = { KW_ANY ~ KW_VALUE }
type_simple_name = { symbolic_name }
type_parameters = { "<" ~ type_expression ~ ("," ~ type_expression)* ~ ">" }
type_suffix = { KW_LIST | KW_ARRAY }
nullability = { KW_NOT ~ KW_NULL | "!" }
vector_type = { KW_VECTOR ~ (vector_angle_type | vector_paren_type)? }
vector_angle_type = _{ "<" ~ vector_coordinate_literal ~ ">" ~ ("(" ~ vector_dimension ~ ")")? }
vector_paren_type = _{ "(" ~ vector_dimension ~ ("," ~ vector_coordinate_literal)? ~ ")" }
vector_dimension = @{ ASCII_DIGIT+ }

AND_OP = { KW_AND }
OR_OP = { KW_OR }
XOR_OP = { KW_XOR }
NOT_OP = { KW_NOT }

symbolic_name = @{ escaped_identifier | symbolic_name_raw }
symbolic_name_raw = { (XID_START | "_") ~ (XID_CONTINUE | "_")* }
escaped_identifier = { "`" ~ ("``" | !"`" ~ ANY)* ~ "`" }
ident_continue = _{ XID_CONTINUE | "_" }

